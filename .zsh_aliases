# Quick folder jumps
alias '..'='cd ..'
alias -g ...='../..'
alias -g ....='../../..'
alias -g .....='../../../..'
alias -g ......='../../../../..'

# Common pipiline actions
alias -g G='| grep -i'
alias -g L='| less'
alias -g H='| head'
alias -g T='| tail'
alias -g C='| wc -l'
alias -g S='| sort'
alias -g U='| sort | uniq'
alias -g TOP='| sort | uniq -c | sort -rn'
alias -g D='; say "Task completed"'

# When you are too tired to recognize shell from VIM
alias :e="nvim"
alias :q="exit"

# Edit with nvim instead of vim
alias vim="nvim"
alias vi="nvim"

# Enable verbose mode for common commands
alias ls='ls -FlhG'
alias rm="trash"
alias mv="/bin/mv -v"
alias cp="/bin/cp -Rv"
alias scp="/usr/bin/scp -r"
alias rsync="/usr/bin/rsync -Pa"
alias skill="kill -s SIGKILL"
alias htop="/usr/local/bin/htop -u $USER"

# Git time savers
alias ga="git add . -N"
alias gaa="git add ."
alias gap="clear && git add -p"
alias gbs="git checkout \$(git branch -a | cut -c 3- | sed 's/remotes\/origin\///' | sort | uniq | grep -v '^HEAD' | fzf); gu"
alias gf='git icdiff'
alias gfc='git icdiff --cached'
alias gp="git push || (git pull && git push)"
alias gr="git reset HEAD~1"
alias gc="git branch --merged | egrep -v '(^\*|master|main)' | xargs git branch -d"
alias gs="git status --ignore-submodules -sb"
alias gsu="git status --ignore-submodules -sb | grep '^U'"
alias gco="git checkout -f"
alias gl="git log --topo-order --abbrev-commit --date=short --decorate --boundary --pretty=format:'%Cgreen%ad %Cred%h%Creset%C(yellow)%d%Creset %s %Cblue[%cn]%Creset' "
alias gln="git log --name-only"
alias glc="git rev-parse --short HEAD"
alias gw="gl $(git branch -l main master --format '%(refname:short)')..HEAD"
alias gww="gf $(git branch -l main master --format '%(refname:short)')..HEAD"
alias gt="~/bin/git-track"
alias gu="git pull"

alias rg="rg -i -g '!*node_modules*'"
alias cc="claude --dangerously-skip-permissions --chrome"

# Useful alert for tmux to notify about some finished command in other window/pane
alias bell="echo -e '\a'"

# Quick branch creation and slugification (usually from Jira ticket)
gb() {
  local branch=$(echo "$*" | tr '[:upper:]' '[:lower:]' | tr -cs '[:alnum:]-/' '-' | sed 's/-$//' | sed 's/it2-/IT2-/g')
  git checkout -b "$branch"
}

# Quick search function which ignores node_modules folder and gives search results in colored `less`
function s() {
  rg --smart-case --pretty --glob '!node_modules' --context 5 $@ | less -R
}

# Quickly start tmux project
function ts() {
  local cmd=(tmuxinator start --suppress-tmux-version-warning=SUPPRESS-TMUX-VERSION-WARNING)
  if [ -f .tmuxinator.yml ]; then
    "${cmd[@]}"
  elif [ -n "$1" ]; then
    "${cmd[@]}" "$1"
  else
    "${cmd[@]}" "$(basename "$(pwd)")"
  fi
}

# Quick commit
function gi() {
  if [ -z "$1" ]
  then
    git commit
  else
    git commit -m $@
  fi
}

# Quick alias to test if GPG agent works
alias gpg-add="echo | gpg --clearsign"

# Nice beeper after something gets done
function beep() {
  afplay /System/Library/Sounds/Glass.aiff -v 10
}

# When sourcing Python virtual env - do not prepend it to PROMPT
export VIRTUAL_ENV_DISABLE_PROMPT=1

# Reopen a worktree and its claude session for every Trello card in TO REVIEW.
# The board comes from this repo's line in trello-employee's dispatch.sh.
function resume() {
  emulate -L zsh

  local dispatch="$HOME/Work/tweak-things/trello-employee/dispatch.sh"
  if [[ -z "$TMUX" ]]; then
    echo "resume: run this inside tmux" >&2
    return 1
  fi
  git rev-parse --git-dir > /dev/null 2>&1 || { echo "resume: not in a git repo" >&2; return 1 }

  local main_dir session board json card id name url branch dir checked_out windows claude_cmd target
  main_dir=$(git worktree list --porcelain | head -1)
  main_dir=${main_dir#worktree }
  session=$(tmux display-message -p '#S')

  # PROJECTS lines look like "session|$ROOT/repo|board"
  board=$(grep -m1 -F "/${main_dir:t}|" "$dispatch" | cut -d'|' -f3 | tr -d '"')
  [[ -n $board ]] || { echo "resume: ${main_dir:t} has no board in $dispatch" >&2; return 1 }

  json=$(trello card:list --board "$board" --list "TO REVIEW" --format json 2>/dev/null)
  jq -e 'type == "array"' <<<"$json" > /dev/null 2>&1 \
    || { echo "resume: could not read TO REVIEW on $board (try trello sync)" >&2; return 1 }

  git -C "$main_dir" fetch --quiet --prune origin || echo "resume: fetch failed, using stale refs" >&2
  windows=$(tmux list-windows -t "$session" -F '#W')

  for card in ${(f)"$(jq -c '.[]' <<<"$json")"}; do
    id=$(jq -r '.url | capture("/c/[^/]+/(?<n>[0-9]+)-").n' <<<"$card")
    name=$(jq -r .name <<<"$card")
    url=$(jq -r .url <<<"$card")

    if print -r -- "$windows" | grep -qx "claude-$id"; then
      echo "exists: claude-$id"
      continue
    fi

    # dispatch.sh names branches "<id>-<slug>"; match on the id in case the card was renamed
    branch=$(git -C "$main_dir" for-each-ref --count=1 --format='%(refname:lstrip=2)' "refs/heads/$id-*")
    [[ -z $branch ]] && branch=$(git -C "$main_dir" for-each-ref --count=1 --format='%(refname:lstrip=3)' "refs/remotes/origin/$id-*")
    if [[ -z $branch ]]; then
      echo "resume: no branch for card $id ($name), skipping" >&2
      continue
    fi

    checked_out=$(git -C "$main_dir" worktree list --porcelain | grep -B2 -xF "branch refs/heads/$branch" | head -1)
    if [[ -n $checked_out ]]; then
      dir=${checked_out#worktree }
    else
      dir="$main_dir/.worktrees/$branch"
      if git -C "$main_dir" show-ref --quiet --verify "refs/heads/$branch"; then
        git -C "$main_dir" worktree add --quiet "$dir" "$branch" || { echo "resume: could not add $dir, skipping" >&2; continue }
        git -C "$dir" merge --quiet --ff-only "origin/$branch" 2>/dev/null \
          || echo "resume: $branch diverged from origin or is not pushed, left as is" >&2
      else
        git -C "$main_dir" worktree add --quiet --track -b "$branch" "$dir" "origin/$branch" \
          || { echo "resume: could not add $dir, skipping" >&2; continue }
      fi
    fi

    # Claude keys sessions by directory, so a recreated worktree finds its old session
    if [[ -n $(print -l "$HOME/.claude/projects/${dir//[^A-Za-z0-9]/-}"/*.jsonl(N)) ]]; then
      claude_cmd="claude --dangerously-skip-permissions --chrome --continue"
    else
      claude_cmd="claude --dangerously-skip-permissions --chrome --name '$url'"
    fi

    # Same placement as dispatch.sh: right after the "claude" window, else at the end
    # Braces matter: zsh reads "$session:c..." as the :c history modifier
    target=$(tmux new-window -d -a -t "${session}:claude" -n "claude-$id" -c "$dir" -P -F '#{window_id}' 2>/dev/null ||
      tmux new-window -d -t "${session}:" -n "claude-$id" -c "$dir" -P -F '#{window_id}') || continue
    tmux send-keys -t "$target" "$claude_cmd && git worktree remove . && exit" Enter
    echo "opened: claude-$id ($name)"
  done
}

# New worktree off latest main, branch slugified from a title, with Claude in a tmux window at position 4
function start() {
  emulate -L zsh
  setopt extended_glob

  local title="${${*##[[:space:]]#}%%[[:space:]]#}" slug
  slug=${(L)title}
  slug=${slug//[^a-z0-9]##/-}
  slug=${${slug#-}%-}

  if [[ -z "$slug" ]]; then
    echo "usage: start <title>" >&2
    return 1
  fi
  if [[ -z "$TMUX" ]]; then
    echo "start: run this inside tmux" >&2
    return 1
  fi
  git rev-parse --git-dir > /dev/null 2>&1 || { echo "start: not in a git repo" >&2; return 1 }

  local main_dir dir session
  main_dir=$(git worktree list --porcelain | head -1)
  main_dir=${main_dir#worktree }
  dir="$main_dir/.worktrees/$slug"
  session=$(tmux display-message -p '#S')

  git -C "$main_dir" fetch --quiet origin main || { echo "start: fetch failed" >&2; return 1 }
  git -C "$main_dir" branch --no-track "$slug" origin/main || return 1
  git -C "$main_dir" worktree add "$dir" "$slug" || return 1

  local target
  target=$(tmux new-window -a -t "$session:3" -n "claude-$slug" -c "$dir" -P -F '#{session_name}:#{window_index}')
  tmux send-keys -t "$target" "claude --dangerously-skip-permissions --chrome --name ${(q)title} && git worktree remove . && exit" Enter
}
